<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent white with blur-like feel using alpha -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80FFFFFF" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <!-- Inner gradient highlight -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:startColor="#33FFFFFF" android:endColor="#1AFFFFFF" android:angle="90" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>

