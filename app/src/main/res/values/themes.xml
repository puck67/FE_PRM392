<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - NoActionBar, red/white/gray palette -->
    <style name="Theme.Prm" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/gray_600</item>
        <item name="colorSecondaryVariant">@color/gray_300</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Material components tinting -->
        <item name="materialButtonStyle">@style/Widget.Prm.Button</item>
    </style>

    <style name="Widget.Prm.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>